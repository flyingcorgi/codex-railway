# Default Codex config for the Railway box.
#
# Seeded onto the volume at $CODEX_HOME/config.toml on FIRST BOOT ONLY — edit it
# freely inside the box, redeploys will never overwrite your changes.
# Full reference: https://github.com/openai/codex/blob/main/docs/config.md

# ── Sandbox & approvals ─────────────────────────────────────────────────────
# This whole container is disposable and isolated from your machine, so the
# container *is* the sandbox. Running Codex unsandboxed inside it is the setting
# that makes a remote box feel like a local session — otherwise every command
# stops for an approval prompt you have to babysit.
#
# Trade-off, stated plainly: with these values the agent can run any command and
# reach the network inside this container. That is the point of a remote agent
# box, but do not paste secrets in here that you would not give the agent.
#
# DO NOT switch to sandbox_mode = "workspace-write" on Railway — it does not
# work. Codex's Linux sandbox needs bubblewrap, and bwrap cannot create a user
# namespace inside a Railway container (verified: "Creating new namespace failed:
# Operation not permitted"), so every sandboxed command fails. This is a platform
# constraint, not a config mistake. danger-full-access is the only working mode
# here — which is fine, because the container is already the isolation boundary.
# approval_policy is seeded from the CODEX_APPROVAL_POLICY Railway variable on
# first boot (default "on-request"; the only other accepted value is "never").
#
# Why not "never" by default: this box stores credentials that reach OUTSIDE the
# container — your ChatGPT login in auth.json, the generated SSH key you add to
# GitHub, and GITHUB_TOKEN if you set it. Network egress can't be restricted here
# (no sandbox, see below), so with approvals off, a prompt injection in any repo
# or page the agent reads can exfiltrate them with no friction, and the volume
# means a redeploy doesn't undo it. "on-request" puts a human in that path.
#
# Set CODEX_APPROVAL_POLICY=never if you want unattended YOLO operation and
# accept that trade. Editing this file by hand works too — it is never
# overwritten once seeded.
approval_policy = "on-request"
sandbox_mode = "danger-full-access"

# ── Model ───────────────────────────────────────────────────────────────────
# Uncomment to pin a model; otherwise Codex uses its own default, which tracks
# whatever is current for your plan.
# model = "gpt-5.1-codex"

# ── Credentials ─────────────────────────────────────────────────────────────
# Codex can cache credentials in an OS keyring instead of auth.json. There is no
# keyring in this container, and a keyring wouldn't survive a redeploy anyway —
# so pin the file store explicitly rather than relying on "auto" to guess right.
# auth.json then lives on the volume and your login persists.
# Accepted values (0.149.1): "file", "keyring", "auto", "ephemeral".
cli_auth_credentials_store = "file"

# ── TUI ─────────────────────────────────────────────────────────────────────
# Keep [tui] last: TOML puts every key after a table header inside that table,
# so a top-level setting added below this line would silently become tui.*.

[tui]
# Animations off by default, because they break copy/paste in the browser
# terminal — the door most people use on this box.
#
# The spinner/shimmer repaints at ~31 Hz. Every repaint makes xterm.js drop the
# text selection, so a highlight vanishes about a second after you make it and
# Cmd/Ctrl+C copies nothing. Upstream bug: openai/codex#38017, which names this
# exact setting as the fix.
#
# It cannot be fixed on the terminal side: the usual answer is OSC 52
# (tmux `set -g set-clipboard on`), but ttyd 1.7.7's bundled xterm.js registers
# no OSC 52 handler, and 1.7.7 is the newest release — the OSC 52 pull requests
# are still open upstream.
#
# Set to true if you would rather have the spinners and only copy over SSH.
animations = false
