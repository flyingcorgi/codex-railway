# ── Codex authentication ────────────────────────────────────
# Two ways in — pick one.
#
# 1) ChatGPT plan (Plus / Pro / Business / Edu / Enterprise) — RECOMMENDED if you
#    already pay for one. Leave OPENAI_API_KEY blank, then run ONCE inside the box:
#        codex login --device-auth
#    It prints a short code you approve at chatgpt.com from any device. The login
#    is written to the /workspace volume and survives redeploys.
#
# 2) API key — set this and the box authenticates itself on every boot.
#    NOTE: this bills at OpenAI API rates, NOT against a ChatGPT plan.
OPENAI_API_KEY=

# Enterprise workspaces only: an admin-issued Codex access token, used instead of
# the two options above.
CODEX_ACCESS_TOKEN=

# ── Agent permissions ───────────────────────────────────────
# Seeded into config.toml on FIRST BOOT only. Two accepted values:
#
#   on-request  (default) — Codex asks before running commands. Recommended:
#                this box holds your ChatGPT login, an SSH key you add to GitHub,
#                and optionally GITHUB_TOKEN, and Railway cannot sandbox network
#                access — so approvals are the only thing standing between a
#                prompt injection and those credentials.
#   never       — unattended "YOLO mode". Faster and fully hands-off; accepts the
#                trade above. Shows a YOLO banner in the TUI.
CODEX_APPROVAL_POLICY=on-request

# ── Optional: GitHub ────────────────────────────────────────
# A token here authenticates `gh` and HTTPS `git` inside the box on boot.
GITHUB_TOKEN=

# ── Optional: git identity for commits made from the box ────
GIT_USER_NAME=
GIT_USER_EMAIL=

# ── Browser terminal (ttyd) ─────────────────────────────────
# The container's main process is ttyd, served on the public Railway domain and
# protected with HTTP basic auth. It hands out a writable shell, so it is never
# left open: leave the password blank to have one generated on first boot and
# persisted on the volume (printed in the deploy logs). Set it to choose your own.
CODEX_WEB_USERNAME=codex
CODEX_WEB_PASSWORD=
# Port ttyd binds to (Railway maps the public domain to this). Default 8080.
PORT=8080
